# LLM: set ONE of these. Claude is preferred when both are present (override with LLM_PROVIDER).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Required for reliable scraping: Apify API token (https://console.apify.com/account/integrations)
APIFY_TOKEN=

# Optional overrides
# LLM_PROVIDER=anthropic|gemini
# ANALYSIS_MODEL=claude-opus-5-5   (gemini default: gemini-2.5-flash)
# DATE_MODEL=claude-opus-5-5       (gemini default: gemini-2.5-flash-lite)
# GEMINI_RPM=9                      free-tier requests/minute per model
# DATE_EFFORT=low
# DATES_PER_PERSON=4
# DATE_TURNS=8
# LLM_CONCURRENCY=8
# PORT=3000
